# Error Handling

## Error Boundaries

### Implementation Pattern

Error boundaries must be class components:

```typescript
// components/feedback/Error/ErrorBoundary/index.tsx
import { Component, ErrorInfo, ReactNode } from "react";
import { logger } from "@/lib/logger";

interface Props {
  children: ReactNode;
  fallback?: ReactNode;
  onError?: (error: Error, errorInfo: ErrorInfo) => void;
}

interface State {
  hasError: boolean;
  error?: Error;
  errorInfo?: ErrorInfo;
}

export class ErrorBoundary extends Component<Props, State> {
  constructor(props: Props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: Error): State {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: ErrorInfo) {
    // Generate unique error ID for tracking
    const errorId = `ERR_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;

    // Log error with centralized logger
    logger.error("React Error Boundary caught an error", error, {
      errorId,
      componentStack: errorInfo.componentStack,
      errorBoundary: true,
    });

    this.props.onError?.(error, errorInfo);
    this.setState({ errorInfo });
  }

  render() {
    if (this.state.hasError) {
      if (this.props.fallback) {
        return this.props.fallback;
      }
      return <DefaultErrorFallback error={this.state.error} />;
    }

    return this.props.children;
  }
}
```

### Error Boundary Placement

Place error boundaries at strategic levels:

```typescript
// ✅ GOOD - Root level for critical errors
<ErrorBoundary>
  <App />
</ErrorBoundary>

// ✅ GOOD - Route level for route-specific errors
<ErrorBoundary fallback={<RouteErrorFallback />}>
  <RouteComponent />
</ErrorBoundary>

// ✅ GOOD - Feature level for isolated features
<ErrorBoundary fallback={<FeatureErrorFallback />}>
  <ComplexFeature />
</ErrorBoundary>
```

### Error Boundary Limitations

Error boundaries **DO NOT** catch:
- Event handlers
- Asynchronous code (setTimeout, promises)
- Server-side rendering errors
- Errors thrown in the error boundary itself

```typescript
// ❌ BAD - Error boundary won't catch this
function Component() {
  const handleClick = () => {
    throw new Error('Event handler error'); // Not caught
  };
  return <button onClick={handleClick}>Click</button>;
}

// ✅ GOOD - Handle errors in event handlers
function Component() {
  const handleClick = () => {
    try {
      // Risky operation
    } catch (error) {
      logger.error('Click handler error', error);
      toast.error('An error occurred');
    }
  };
  return <button onClick={handleClick}>Click</button>;
}
```

## API Error Handling

### Service Layer Error Handling

```typescript
// services/BaseService.ts
class BaseService {
  protected async request<T>(config: RequestConfig): Promise<T> {
    try {
      const response = await fetch(url, options);

      if (!response.ok) {
        throw new ApiError(
          response.status,
          await response.json(),
          `API Error: ${response.statusText}`
        );
      }

      return await response.json();
    } catch (error) {
      if (error instanceof ApiError) {
        throw error;
      }

      // Network errors, timeouts, etc.
      logger.error('Request failed', error);
      throw new ApiError(0, null, 'Network error occurred');
    }
  }
}
```

### React Query Error Handling

```typescript
// ✅ GOOD - Handle errors in components
export const UserList = () => {
  const { data, error, isLoading } = useUsers();

  if (isLoading) return <LoadingSpinner />;

  if (error) {
    if (error instanceof ApiError) {
      if (error.status === 404) {
        return <NotFound message="Users not found" />;
      }
      if (error.status >= 500) {
        return <ServerError message="Server error. Please try again later." />;
      }
    }
    return <ErrorMessage error={error} />;
  }

  return <UserListContent users={data} />;
};
```

### Global Error Handler

Use `QueryCache` and `MutationCache` for global error handling. **Do not use `onError` inside `defaultOptions`** — that callback was removed in TanStack Query v5.

```typescript
// lib/api/query-client.ts
import { QueryClient, QueryCache, MutationCache } from '@tanstack/react-query';

export const queryClient = new QueryClient({
  queryCache: new QueryCache({
    onError: (error) => {
      logger.error('Query error', error);

      if (error instanceof ApiError) {
        if (error.status >= 500) {
          toast.error('A server error occurred. Please try again later.');
        } else if (error.status === 401) {
          // Handle unauthorized - redirect to login
          authService.logout();
        }
      }
    },
  }),
  mutationCache: new MutationCache({
    onError: (error) => {
      logger.error('Mutation error', error);

      if (error instanceof ApiError && error.status >= 400) {
        toast.error(error.message || 'An error occurred');
      }
    },
  }),
});
```

## Form Error Handling

### Field-Level Errors

```typescript
// ✅ GOOD - Field-level validation errors
function LoginForm() {
  const form = useForm({
    resolver: zodResolver(loginSchema),
  });

  return (
    <form onSubmit={form.handleSubmit(onSubmit)}>
      <div>
        <Label htmlFor="email">Email</Label>
        <Input
          id="email"
          {...form.register("email")}
          aria-invalid={!!form.formState.errors.email}
        />
        <FormMessage>
          {form.formState.errors.email?.message}
        </FormMessage>
      </div>
    </form>
  );
}
```

### Submission Errors

```typescript
// ✅ GOOD - Handle submission errors
function LoginForm() {
  const form = useForm({
    resolver: zodResolver(loginSchema),
  });

  const mutation = useLogin();

  const onSubmit = async (data: LoginFormValues) => {
    try {
      await mutation.mutateAsync(data);
      toast.success('Login successful');
    } catch (error) {
      if (error instanceof ApiError) {
        if (error.status === 401) {
          form.setError('root', {
            message: 'Invalid email or password',
          });
        } else {
          toast.error('Login failed. Please try again.');
        }
      }
    }
  };

  return (
    <form onSubmit={form.handleSubmit(onSubmit)}>
      {form.formState.errors.root && (
        <Alert variant="destructive">
          {form.formState.errors.root.message}
        </Alert>
      )}
      {/* Form fields */}
    </form>
  );
}
```

## User-Friendly Error Messages

### Error Message Patterns

```typescript
// ✅ GOOD - User-friendly error messages
const getErrorMessage = (error: unknown): string => {
  if (error instanceof ApiError) {
    switch (error.status) {
      case 400:
        return 'Invalid request. Please check your input.';
      case 401:
        return 'You are not authorized. Please log in.';
      case 403:
        return 'You do not have permission to perform this action.';
      case 404:
        return 'The requested resource was not found.';
      case 429:
        return 'Too many requests. Please try again later.';
      case 500:
        return 'A server error occurred. Please try again later.';
      default:
        return 'An error occurred. Please try again.';
    }
  }

  if (error instanceof Error) {
    return error.message;
  }

  return 'An unexpected error occurred.';
};
```

### Error Display Components

```typescript
// components/feedback/Error/ErrorMessage/index.tsx
interface ErrorMessageProps {
  error: unknown;
  title?: string;
  onRetry?: () => void;
}

export function ErrorMessage({ error, title, onRetry }: ErrorMessageProps) {
  const message = getErrorMessage(error);

  return (
    <Alert variant="destructive">
      <AlertTitle>{title ?? 'Error'}</AlertTitle>
      <AlertDescription>{message}</AlertDescription>
      {onRetry && (
        <Button onClick={onRetry} variant="outline">
          Try Again
        </Button>
      )}
    </Alert>
  );
}
```

## Logging and Monitoring

### Centralized Logging

```typescript
// ✅ GOOD - Use centralized logger
import { logger } from '@/lib/logger';

try {
  await riskyOperation();
} catch (error) {
  logger.error('Operation failed', error, {
    operation: 'riskyOperation',
    userId: user?.id,
    timestamp: new Date().toISOString(),
  });
}
```

### Error Tracking

```typescript
// ✅ GOOD - Track errors with context
componentDidCatch(error: Error, errorInfo: ErrorInfo) {
  const errorId = generateErrorId();

  logger.error('Error boundary caught error', error, {
    errorId,
    componentStack: errorInfo.componentStack,
    userAgent: navigator.userAgent,
    url: window.location.href,
  });

  // Send to error tracking service (Grafana Faro)
  faro.api.pushError(error, {
    errorId,
    componentStack: errorInfo.componentStack,
  });
}
```

## Best Practices

### 1. Always Provide Fallback UI

```typescript
// ✅ GOOD - User-friendly fallback
<ErrorBoundary fallback={<ErrorFallback />}>
  <App />
</ErrorBoundary>

// ❌ BAD - No fallback, blank screen
<ErrorBoundary>
  <App />
</ErrorBoundary>
```

### 2. Log Errors with Context

```typescript
// ✅ GOOD - Rich error context
logger.error('Login failed', error, {
  userId: user?.id,
  email: formData.email,
  timestamp: new Date().toISOString(),
});

// ❌ BAD - No context
logger.error('Login failed', error);
```

### 3. Handle Different Error Types

```typescript
// ✅ GOOD - Handle different error types
if (error instanceof ApiError) {
  // Handle API errors
} else if (error instanceof ValidationError) {
  // Handle validation errors
} else if (error instanceof NetworkError) {
  // Handle network errors
} else {
  // Handle unknown errors
}
```

### 4. Provide Recovery Options

```typescript
// ✅ GOOD - Allow user to retry
<ErrorMessage error={error} onRetry={() => refetch()} />

// ❌ BAD - No recovery option
<ErrorMessage error={error} />
```

## Anti-Patterns to Avoid

### ❌ Silent Failures

```typescript
// ❌ BAD - Error swallowed
try {
  await riskyOperation();
} catch (error) {
  // Silent failure - user doesn't know what happened
}

// ✅ GOOD - Log and notify user
try {
  await riskyOperation();
} catch (error) {
  logger.error('Operation failed', error);
  toast.error('Operation failed. Please try again.');
}
```

### ❌ Generic Error Messages

```typescript
// ❌ BAD - Not helpful
toast.error('An error occurred');

// ✅ GOOD - Specific and actionable
toast.error('Failed to save user. Please check your connection and try again.');
```

### ❌ Catching Errors Too Broadly

```typescript
// ❌ BAD - Catches everything, loses error type
try {
  await operation();
} catch (error) {
  console.log('Error'); // Lost error information
}

// ✅ GOOD - Specific error handling
try {
  await operation();
} catch (error) {
  if (error instanceof ApiError) {
    handleApiError(error);
  } else {
    handleUnknownError(error);
  }
}
```
