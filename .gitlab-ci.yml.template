workflow:
  rules:
    # Skip branch pipeline for release branches (created by release-conventional)
    - if: $CI_COMMIT_BRANCH =~ /^release\//
      when: never
    # MR push: CI + CD to INTG (app testable before merge)
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_IS_DRAFT != "true"
    # Post-merge: auto-release only (no CD to INTG)
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    # Release tag: CD to PROD
    - if: $CI_COMMIT_TAG =~ /^v?\d/
    # Manual trigger: set MANUAL_DEPLOY_ENV=intg|prod to force deploy
    - if: $CI_PIPELINE_SOURCE == "web"

variables:
  MANUAL_DEPLOY_ENV:
    value: "prod"
    description: "Target environment for manual deploy (intg or prod). Leave empty to skip deploy."

stages:
  - infra:plan
  - infra:apply
  - trigger_apps
  - release

include:
  # ── Release (auto-triggered on merge commit) ──────────────────────────
  - component: $CI_SERVER_FQDN/latamairlines/oper/emx/config/devops/components/cd/release-conventional@2.11.2
    inputs:
      is_monorepo_product: true
      commit_message_regex: '/^Merge branch\s.+/i'

  # ── Trigger Apps ──────────────────────────────────────────────────────
  - component: $CI_SERVER_FQDN/latamairlines/oper/emx/config/devops/components/ci/trigger-apps@0.4.1
    inputs:
      app_name: backend
  - component: $CI_SERVER_FQDN/latamairlines/oper/emx/config/devops/components/ci/trigger-apps@0.4.1
    inputs:
      app_name: web

  # ── Infra: INTG (plan + apply during MR, apply on direct push) ───────
  - component: $CI_SERVER_FQDN/latamairlines/oper/emx/config/devops/components/cd/deploy-terraform@2.11.3
    inputs:
      auto_approval: true
      environment: intg
      changes:
        - "infra/_base/**"
        - "infra/intg/**"

  # ── Infra: PROD (plan on MR if infra/prod changed, apply on tag) ────
  - component: $CI_SERVER_FQDN/latamairlines/oper/emx/config/devops/components/cd/deploy-terraform@2.11.3
    inputs:
      environment: prod
      changes:
        - "infra/_base/**"
        - "infra/prod/**"

# ── Override: skip trigger on release/* MRs; fire on tag for prod deploy ─────
trigger-backend:
  rules:
    # Skip on release MR — security scans run but app CI/CD is not needed
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_BRANCH_NAME =~ /^release\//
      when: never
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_IS_DRAFT != "true"
      changes:
        - apps/backend/**/*
        - shared/**/*
        - pnpm-workspace.yaml
        - pnpm-lock.yaml
        - package.json
        - .gitlab-ci.yml
    - if: $CI_COMMIT_TAG =~ /^v?\d/
    - if: $CI_PIPELINE_SOURCE == "web" && $MANUAL_DEPLOY_ENV != ""

trigger-web:
  rules:
    # Skip on release MR — security scans run but app CI/CD is not needed
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_BRANCH_NAME =~ /^release\//
      when: never
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_IS_DRAFT != "true"
      changes:
        - apps/web/**/*
        - shared/**/*
        - pnpm-workspace.yaml
        - pnpm-lock.yaml
        - package.json
        - .gitlab-ci.yml
    - if: $CI_COMMIT_TAG =~ /^v?\d/
    - if: $CI_PIPELINE_SOURCE == "web" && $MANUAL_DEPLOY_ENV != ""

# ── Minimal pipeline for release/* MRs (satisfies security policy requirement) ─
release:trigger-release-version:
  stage: release
  image: alpine:latest
  tags: ["latam-emx-kubernetes"]
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_BRANCH_NAME =~ /^release\//
      when: on_success
    - when: never
  script:
    - |
      VERSION=$(grep '"version"' package.json | head -1 | sed 's/.*"version": "\(.*\)".*/\1/')
      echo "Release version: ${VERSION}"
      echo "Branch: ${CI_COMMIT_REF_NAME}"
