{
  "name": "@lafken/react",
  "version": "0.1.0",
  "private": true,
  "license": "PROPRIETARY",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./test/**/*.{ts,tsx}\"",
    "format": "prettier --write \"./**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "format-check": "prettier --check \"./**/*.{ts,tsx}\" --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@lafken/client": "workspace:*",
    "@lafken/upload": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@shared/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "jsdom": "^28.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vitest": "^4.1.2"
  }
}
