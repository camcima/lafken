###############################################################################
# Service Account
###############################################################################

output "service_accounts_email" {
  description = "Email of all service accounts created here"
  value       = {
    backend = google_service_account.backend_sa.email
    web     = google_service_account.web_sa.email
  }
}

output "service_accounts_name" {
  description = "Name of all service accounts created here"
  value       = {
    backend = google_service_account.backend_sa.name
    web     = google_service_account.web_sa.name
  }
}

###############################################################################
# Cloud SQL
###############################################################################

output "cloud_sql_connection_name" {
  description = "Connection name for Cloud SQL instance (format: project:region:instance)"
  value       = module.postgres.instance_connection_name
}

output "cloud_sql_instance_name" {
  description = "Name of the Cloud SQL instance"
  value       = module.postgres.instance_name
}

output "cloud_sql_private_ip" {
  description = "Private IP address of the Cloud SQL instance (auto-generated by GCP, for technical reference only - use connection_name for application connections)"
  value       = module.postgres.private_ip_address
  sensitive   = false
}

###############################################################################
# Azure App Register
###############################################################################

output "azure_app_register_client_id" {
  description = "Client ID of the Azure App Register"
  value       = module.latam-appregister.application_id
}

output "azure_app_register_owners" {
  description = "Client secret of the Azure App Register"
  value       = module.latam-appregister.owners
}

###############################################################################
# Load Balancer
###############################################################################

output "load_balancer_ip" {
  description = "Global IP address for Load Balancer"
  value       = google_compute_global_address.lb_global_ip.address
}

output "load_balancer_ip_name" {
  description = "Name of the global IP address resource"
  value       = google_compute_global_address.lb_global_ip.name
}

###############################################################################
# Port.io DNS Values
###############################################################################

output "port_io_dns_values" {
  description = "Values needed for Port.io DNS form"
  value = {
    is_gcp_latam_ip = true
    it_element      = var.project_key
    gcp_project     = var.project_id
    ip_address      = google_compute_global_address.lb_global_ip.address
    environment     = var.environment
    region          = var.region
    # Note: Domain and Zone fields must be filled manually based on DNS team validation
    # Example domain: app-lafken-prod.latam.com
    # Example zone: AKAMAI
  }
}
