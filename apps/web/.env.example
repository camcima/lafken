# Web App Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# How it works:
#   In production, runtime config is injected via envsubst into public/config.js
#   at container startup (see config.js.template and entrypoint.sh).
#
#   In local dev, the vite-dev-runtime-config plugin merges VITE_* variables
#   from this file (.env.example) with .env.local, then generates public/config.js
#   automatically when the dev server starts. Precedence (later wins):
#     1. .env.example  — committed defaults; safe baseline for fresh checkouts
#     2. .env.local    — developer-specific overrides (gitignored)
#
#   This means a fresh clone with no .env.local still boots against the values
#   below; you only need .env.local to override something.
#
#   The VITE_ prefix is stripped to match the __APP_CONFIG__ keys:
#     VITE_API_URL=http://localhost:3000  →  API_URL: "http://localhost:3000"
#
#   getRuntimeValue() works identically in dev and prod — no code branching,
#   no import.meta.env access in app code.
#
#   Changes to either file require a dev server restart (standard Vite behavior).

# ── Runtime config (mapped to __APP_CONFIG__ via the dev plugin) ──────────────
VITE_ENVIRONMENT="intg"
VITE_AUTH_PROVIDER="oidc"
# VITE_AUTH_PROVIDER="mock"    # Use mock for Storybook / unit tests
VITE_API_URL="http://localhost:3000"
VITE_MONITORING_URL=

# ── OIDC (dev-oidc, Entra, Auth0, Keycloak — anything OIDC-compliant) ─────────
VITE_OIDC_AUTHORITY="http://localhost:8095"
VITE_OIDC_CLIENT_ID="lafken-web"
VITE_OIDC_AUDIENCE="lafken-api"
VITE_OIDC_REDIRECT_URI="http://localhost:5173/auth/callback"
VITE_OIDC_POST_LOGOUT_REDIRECT_URI="http://localhost:5173/auth/login"
VITE_OIDC_SCOPES="openid profile email"
