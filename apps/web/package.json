{
  "name": "web",
  "private": true,
  "license": "PROPRIETARY",
  "publish": false,
  "type": "module",
  "scripts": {
    "// ======================== development & build ======================== //": "",
    "dev": "vite --clearScreen false",
    "dev:host": "pnpm dev --host",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "// ============================== testing ============================== //": "",
    "test": "vitest run",
    "test:debug": "vitest run --reporter=verbose --no-coverage",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "unit/test": "vitest run --project unit",
    "unit/test:watch": "vitest watch --project unit",
    "integration/test": "vitest run --project integration",
    "// ============================== linting ============================== //": "",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:css:fix": "stylelint 'src/**/*.css' --fix",
    "// ============================== formatting ============================== //": "",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.config.{ts,js,mjs}\" --ignore-path ../../.prettierignore",
    "format-check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.config.{ts,js,mjs}\" --ignore-path ../../.prettierignore",
    "// ============================== storybook ============================== //": "",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "// ============================== other ============================== //": "",
    "init:msw": "pnpm exec msw init public --config",
    "check-outdated": "pnpm outdated",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@shared/backend-api": "workspace:*",
    "@azure/msal-browser": "^5.6.3",
    "@grafana/faro-react": "^2.2.4",
    "@grafana/faro-web-tracing": "^2.2.4",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.168.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.4",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.2",
    "@shared/typescript-config": "workspace:*",
    "@storybook/react-vite": "^10.3.4",
    "@stylistic/stylelint-config": "^5.0.0",
    "@stylistic/stylelint-plugin": "^5.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-devtools": "^0.10.1",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/router-plugin": "^1.167.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "10.2.13",
    "jsdom": "^28.0.0",
    "msw": "^2.13.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "shadcn": "^4.1.2",
    "storybook": "^10.3.4",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.5",
    "web-vitals": "^5.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "msw": {
    "workerDirectory": "./public"
  }
}
