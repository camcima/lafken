// Runtime configuration generated from Cloud Run environment variables
// This file is processed by envsubst at container startup
// Template variables use ${VAR} or ${VAR:-default} syntax

(function () {
  if ("__APP_CONFIG__" in globalThis) {
    throw new Error("[security] __APP_CONFIG__ was already defined before config.js loaded");
  }

  Object.defineProperty(globalThis, "__APP_CONFIG__", {
    value: Object.freeze({
      ENVIRONMENT: "${ENVIRONMENT:-intg}",
      AUTH_PROVIDER: "${AUTH_PROVIDER:-oidc}",
      OIDC_AUTHORITY: "${OIDC_AUTHORITY:-}",
      OIDC_CLIENT_ID: "${OIDC_CLIENT_ID:-}",
      OIDC_AUDIENCE: "${OIDC_AUDIENCE:-}",
      OIDC_REDIRECT_URI: "${OIDC_REDIRECT_URI:-}",
      OIDC_POST_LOGOUT_REDIRECT_URI: "${OIDC_POST_LOGOUT_REDIRECT_URI:-}",
      OIDC_SCOPES: "${OIDC_SCOPES:-openid profile email}",
      MONITORING_URL: "${MONITORING_URL:-}",
      API_URL: "${API_URL:-}",
    }),
    writable: false,
    configurable: false,
    enumerable: true,
  });
})();
