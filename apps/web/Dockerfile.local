# Local-only Dockerfile — uses vanilla nginx:alpine instead of the internal
# LATAM base image so it can be built without GCP registry access.
#
# nginx:alpine ships with ngx_http_sub_module compiled in, so sub_filter
# (and therefore CSP nonce injection) works exactly as it would in production.
#
# Build context must be the monorepo root:
#   docker build -f apps/web/Dockerfile.local -t pma-web:local .
#
# Or via docker compose (see docker-compose.yml in this directory).

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

FROM base AS builder

RUN apk add --no-cache libc6-compat python3 make g++

# Copy workspace manifests first so pnpm install is cached independently
# of source changes
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY apps/web/package.json                           ./apps/web/
COPY shared/typescript-config/package.json           ./shared/typescript-config/
COPY shared/style-config/package.json                ./shared/style-config/

RUN pnpm install --frozen-lockfile

# Copy source for the packages we actually need
COPY apps/web/         ./apps/web/
COPY shared/typescript-config/ ./shared/typescript-config/
COPY shared/style-config/      ./shared/style-config/

RUN pnpm --filter web build

# ── Stage 2: runner ───────────────────────────────────────────────────────────
FROM nginx:alpine AS runner

ARG PORT=8080
EXPOSE ${PORT}

# Mirror the LATAM nginx image directory so nginx.conf and entrypoint.sh
# work without any modification
RUN mkdir -p /opt/app-root/src && chown -R nginx:nginx /opt/app-root/src

WORKDIR /opt/app-root/src

COPY --from=builder --chown=nginx:nginx /app/apps/web/dist                   ./
COPY --from=builder --chown=nginx:nginx /app/apps/web/nginx.conf             /etc/nginx/conf.d/default.conf
COPY --from=builder --chown=nginx:nginx /app/apps/web/security-headers.conf  /etc/nginx/conf.d/security-headers.conf
COPY --from=builder --chown=nginx:nginx /app/apps/web/public/config.js.template ./config.js.template
COPY --from=builder --chown=nginx:nginx /app/apps/web/entrypoint.sh          ./entrypoint.sh

RUN chmod +x ./entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
