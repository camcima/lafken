info:
  title: BE - Template eMantto Project
  description: Backend API for template-emantto-project monorepo
  version: 0.0.0
  contact:
    name: grp_emx_platform_eng@latam.com
    url: mailto:grp_emx_platform_eng@latam.com
    email: grp_emx_platform_eng@latam.com
tags: []
servers:
  - url: https://<%= service_name %>
    description: Cloud Endpoints service URL
    x-google-endpoint:
      allowCors: true
components:
  securitySchemes:
    bearer:
      scheme: bearer
      bearerFormat: JWT
      type: http
      description: Azure AD Bearer token authorization
    azure_ad_jwt:
      type: oauth2
      flows:
        implicit:
          authorizationUrl: ''
          scopes: {}
      x-google-auth:
        issuer: https://login.microsoftonline.com/<%=azure_tenant_id%>/v2.0
        jwksUri: >-
          https://login.microsoftonline.com/<%=azure_tenant_id%>/discovery/v2.0/keys
        audiences:
          - <%=azure_client_id%>
        jwtLocations:
          - header: Authorization
            valuePrefix: 'Bearer '
    api_key:
      type: apiKey
      in: query
      name: key
      description: API key for external clients (e.g., HTTP Sink Connector)
  schemas:
    HealthIndicatorStatusDTO:
      type: object
      properties:
        status:
          type: string
          enum:
            - up
            - down
          description: Status of the specific health indicator
      required:
        - status
    HealthIndicatorResultResponseDTO:
      type: object
      properties:
        application:
          $ref: '#/components/schemas/HealthIndicatorStatusDTO'
        database:
          $ref: '#/components/schemas/HealthIndicatorStatusDTO'
    HealthCheckResultResponseDTO:
      type: object
      properties:
        status:
          type: string
          enum:
            - error
            - ok
            - shutting_down
        info:
          description: Summary information about healthy health indicators
          allOf:
            - $ref: '#/components/schemas/HealthIndicatorResultResponseDTO'
        error:
          description: Summary information about failed health indicators
          allOf:
            - $ref: '#/components/schemas/HealthIndicatorResultResponseDTO'
        details:
          description: Details about all health indicators
          allOf:
            - $ref: '#/components/schemas/HealthIndicatorResultResponseDTO'
      required:
        - status
        - info
        - error
        - details
    UnauthorizedErrorResponseDTO:
      type: object
      properties:
        type:
          type: string
        title:
          type: string
          enum:
            - UnauthorizedException
        status:
          type: number
        detail:
          type: string
        errors:
          type: array
          items:
            type: object
      required:
        - type
        - title
        - status
        - detail
        - errors
    NamespaceResponseDTO:
      type: object
      properties:
        slug:
          type: string
        displayName:
          type: string
        description:
          type: string
        currentPolicyVersion:
          type: number
        storageBindingName:
          type: string
        archivedAt:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
      required:
        - slug
        - displayName
        - currentPolicyVersion
        - storageBindingName
        - createdAt
        - updatedAt
    PaginatedNamespacesResponseDTO:
      type: object
      properties:
        data:
          type: array
          items:
            $ref: '#/components/schemas/NamespaceResponseDTO'
        total:
          type: number
        limit:
          type: number
        page:
          type: number
        lastPage:
          type: number
      required:
        - data
        - total
        - limit
        - page
        - lastPage
    NamespacePolicyResponseDTO:
      type: object
      properties:
        version:
          type: number
        retentionDays:
          type: number
        retentionMode:
          type: string
          enum:
            - delete
            - archive
            - none
        maxFileSizeBytes:
          type: number
        allowedMimeTypes:
          type: array
          items:
            type: string
        exifHandling:
          type: string
          enum:
            - strip
            - preserve
            - extract_then_strip
        virusScanRequired:
          type: boolean
        contentModeration:
          type: object
        requiredMetadataSchema:
          type: object
        immutable:
          type: boolean
        servingMode:
          type: string
          enum:
            - public
            - signed
            - proxied
        signedUrlTtlSeconds:
          type: number
        signedUrlBucketSize:
          type: number
        retryConfig:
          type: object
        createdBy:
          type: string
        createdAt:
          type: string
      required:
        - version
        - retentionMode
        - maxFileSizeBytes
        - allowedMimeTypes
        - exifHandling
        - virusScanRequired
        - immutable
        - servingMode
        - createdAt
    NamespacePresetResponseDTO:
      type: object
      properties:
        name:
          type: string
        version:
          type: number
        transformation:
          type: object
        cdnMaxAge:
          type: number
        signedUrlTtl:
          type: number
        preGenerate:
          type: boolean
        requiredPermission:
          type: string
        description:
          type: string
        active:
          type: boolean
        createdAt:
          type: string
      required:
        - name
        - version
        - transformation
        - preGenerate
        - active
        - createdAt
    AssetResponseDTO:
      type: object
      properties:
        publicId:
          type: string
        namespaceSlug:
          type: string
        policyVersion:
          type: number
        state:
          type: string
          enum:
            - pending
            - uploaded
            - processing
            - ready
            - rejected
            - quarantined_virus
            - quarantined_moderation
            - processing_failed
            - expired
            - deleted
        stateReason:
          type: string
        sizeBytes:
          type: number
        mimeType:
          type: string
        declaredMimeType:
          type: string
        width:
          type: number
        height:
          type: number
        contentHashHex:
          type: string
        uploadedBy:
          type: string
        owningRecordType:
          type: string
        owningRecordId:
          type: string
        customMetadata:
          type: object
        captureContext:
          type: object
        legalHold:
          type: boolean
        confirmedAt:
          type: string
        stateChangedAt:
          type: string
        createdAt:
          type: string
      required:
        - publicId
        - namespaceSlug
        - policyVersion
        - state
        - customMetadata
        - legalHold
        - stateChangedAt
        - createdAt
    PaginatedAssetResponseDTO:
      type: object
      properties:
        data:
          type: array
          items:
            $ref: '#/components/schemas/AssetResponseDTO'
        total:
          type: number
        limit:
          type: number
        page:
          type: number
        lastPage:
          type: number
      required:
        - data
        - total
        - limit
        - page
        - lastPage
    AssetStateTransitionResponseDTO:
      type: object
      properties:
        fromState:
          type: string
          enum:
            - pending
            - uploaded
            - processing
            - ready
            - rejected
            - quarantined_virus
            - quarantined_moderation
            - processing_failed
            - expired
            - deleted
        toState:
          type: string
          enum:
            - pending
            - uploaded
            - processing
            - ready
            - rejected
            - quarantined_virus
            - quarantined_moderation
            - processing_failed
            - expired
