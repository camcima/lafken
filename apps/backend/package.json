{
  "name": "backend",
  "private": true,
  "license": "PROPRIETARY",
  "publish": false,
  "type": "commonjs",
  "scripts": {
    "// ======================== development & build ======================== //": "",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "build": "nest build --tsc",
    "start": "node --env-file-if-exists=.env ./dist/main.js",
    "dev": "nest start --watch --exec 'node --env-file=.env'",
    "debug": "nest start --debug --watch --exec 'node --env-file=.env'",
    "dep-check": "depcruise --config .dependency-cruiser.js src",
    "// ============================ scripts ============================ //": "",
    "generate-openapi-spec": "nest start --path tsconfig.json --entryFile ./scripts/generate-openapi-spec",
    "postgenerate-openapi-spec": "CLOUD_ENDPOINT_DEFINITION=true nest start --path tsconfig.json --entryFile ./scripts/generate-openapi-spec",
    "// ============================== testing ============================== //": "",
    "test": "vitest run --project unit",
    "test:cov": "vitest run --coverage --project unit",
    "unit/test": "vitest run --project unit",
    "unit/test:watch": "vitest watch --project unit",
    "integration/test": "vitest run --project integration",
    "test-db-migrations:up": "dbmate --no-dump-schema --env DATABASE_URL --env-file .env.test up",
    "test-db-seed:up": "node ./scripts/e2e-run-db-seeds.mjs",
    "e2e/test": "vitest run --project E2E",
    "coverage": "vitest run --coverage --watch=false --merge-reports=.vitest-reports",
    "// ============================ sytle ============================ //": "",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.mjs\" --ignore-path ../../.prettierignore",
    "format-check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" --ignore-path ../../.prettierignore",
    "// ============================== db ============================== //": "",
    "migrate": "dbmate --no-dump-schema --env DATABASE_URL up",
    "migrate:new": "dbmate --no-dump-schema --env DATABASE_URL new",
    "migrate:status": "dbmate --no-dump-schema --env DATABASE_URL status",
    "migrate:rollback": "dbmate --no-dump-schema --env DATABASE_URL down",
    "kysely-codegen": "node --env-file=.env ../../node_modules/kysely-codegen/dist/cli/bin.js --dialect postgres --out-file ./src/shared/infrastructure/persistence/db.types.ts --camel-case --default-schema public --exclude-pattern schema_migrations"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/terminus": "^11.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.70.1",
    "@opentelemetry/context-async-hooks": "^2.6.1",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.212.0",
    "@opentelemetry/instrumentation-pino": "^0.58.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "axios": "^1.14.0",
    "axios-retry": "^4.5.0",
    "body-parser": "^2.2.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "kysely": "^0.28.15",
    "nestjs-otel": "^8.0.2",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "passport-strategy": "^1.0.0",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@shared/backend-api": "workspace:*",
    "@shared/style-config": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "@swc/core": "^1.15.24",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/opossum": "^8.1.9",
    "@types/passport-azure-ad": "^4.3.6",
    "@types/passport-strategy": "^0.2.38",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "dbmate": "^2.32.0",
    "dependency-cruiser": "^17.3.10",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tslib": "^2.8.1",
    "unplugin-swc": "^1.5.9",
    "vitest-mock-extended": "^3.1.1"
  }
}
