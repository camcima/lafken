# APP

NODE_ENV="development"
APP_PORT=3000
LOG_LEVEL="info"
PRETTY_LOGS=true
# Comma-separated list of allowed CORS origins. Empty disables CORS.
# Example: "http://localhost:3000,http://example.com"
CORS_ALLOWED_ORIGINS="*"

# DATABASE

DB_HOST=localhost
DB_PORT=5433
DB_USER=nestjstemplatev2
DB_NAME=nestjstemplatev2
DB_PASSWORD=nestjstemplatev2
DB_SSL=false
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable" ## used by DBmate
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require&channel_binding=require"
# Connection pool tuning. Calculate DB_POOL_MAX from Cloud SQL `max_connections` / expected Cloud Run instances.
DB_POOL_MIN=1
DB_POOL_MAX=200
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=60000
DB_QUERY_TIMEOUT_MS=60000
DB_IDLE_IN_TX_TIMEOUT_MS=100000

# TELEMETRY

# OTEL_SERVICE_NAME="nestjstemplatev2-be"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://alloy:4317"
# OTEL_RESOURCE_ATTRIBUTES="deployment.environment.name=dev"
# Toggles OTLP metric export. Defaults to false in development/test, true elsewhere.
# OTEL_METRICS_ENABLED=true

# AUTH

AUTH_PROVIDER="oidc"
OIDC_ISSUER="http://localhost:8095"
OIDC_AUDIENCE="lafken-api"
OIDC_PRINCIPAL_CLAIM="preferred_username"
OIDC_ROLES_CLAIM="roles"

# GCS

# Dev compose points at fake-gcs-server. Prod leaves both blank to use
# real GCS via Application Default Credentials (workload identity).
# STORAGE_GCS_ENDPOINT is what the backend (and the user's browser) talks to.
# STORAGE_GCS_PREVIEW_SOURCE_ENDPOINT is the hostname imgproxy resolves to
# reach the same fake-gcs from inside the compose network — it only affects
# the host string baked into the V4 signature, not where the backend itself
# connects.
STORAGE_GCS_ENDPOINT=http://localhost:4443
STORAGE_GCS_PREVIEW_SOURCE_ENDPOINT=http://fake-gcs:4443
GCS_SERVICE_ACCOUNT_JSON=

# IMGPROXY

# Dev compose runs imgproxy on http://localhost:8081 and authorizes only
# sources matching IMGPROXY_ALLOWED_SOURCES (set in compose). The backend
# signs URLs with the same key/salt — leave all blank to disable thumbnails.
IMGPROXY_BASE_URL=http://localhost:8081
# The backend mints a V4-signed source URL per render via the GCS adapter and
# embeds it in the imgproxy path, so imgproxy fetches the bucket directly with
# no per-bucket configuration of its own.
IMGPROXY_KEY=943b421c4e44c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4
IMGPROXY_SALT=520b421c4e44c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4f24c4
IMGPROXY_SIGNATURE_SIZE=32

# PROCESSING

# Single-tier exponential backoff for the processing worker. All retries
# release the job back to processing_jobs with not_before = now() + delay.
# Formula: min(initial * multiplier^(attempt-1) * jitter(0.5..1.0), max).
PROCESSING_WORKER_INITIAL_BACKOFF_MS=1000
PROCESSING_WORKER_BACKOFF_MULTIPLIER=3
PROCESSING_WORKER_MAX_BACKOFF_MS=600000
# Whole-workflow upper bound from claim time. On expiry the asset
# transitions to processing_failed with state_reason = 'workflow_timeout'.
PROCESSING_WORKER_WORKFLOW_TIMEOUT_MS=900000

# Selects the virus-scan adapter used by the worker. Values: local | clamav.
# `local` is a deterministic fake driven by PROCESSING_VIRUS_SCAN_FORCE_INFECTED.
# `clamav` connects to a real clamd over TCP (see CLAMAV_* below).
PROCESSING_VIRUS_SCAN_ADAPTER=local
# Forces the local virus-scan adapter to report `quarantine` so the
# quarantine flow can be exercised end-to-end in dev. Only applies when
# PROCESSING_VIRUS_SCAN_ADAPTER=local. Defaults to false.
PROCESSING_VIRUS_SCAN_FORCE_INFECTED=false
# Optional signature reported when PROCESSING_VIRUS_SCAN_FORCE_INFECTED=true.
# PROCESSING_VIRUS_SCAN_SIGNATURE="local-test-signature"
# clamd connection. Used only when PROCESSING_VIRUS_SCAN_ADAPTER=clamav.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_CHUNK_SIZE_BYTES=65536
# Forces the local content-moderation adapter to a specific decision, overriding
# the namespace policy's localDecision field. Values: pass | quarantine.
# Useful to dogfood the moderation-quarantine flow without editing per-namespace policy.
# PROCESSING_CONTENT_MODERATION_FORCE_DECISION=quarantine

# UPLOAD INTENTS
ORPHAN_INTENT_SWEEP_INTERVAL_MS=60000
ORPHAN_INTENT_GRACE_MS=300000
