# Template for .env.test. Copy to .env.test and adjust as needed.
# IMPORTANT: the test stack runs on a SEPARATE Postgres container exposed on
# port 5434 (see docker-compose.test.yml). Do NOT point this file at the dev
# DB on port 5433 — integration tests clean tables in beforeEach and would
# wipe local dev data.

# APP

NODE_ENV="test"
APP_PORT=3000
LOG_LEVEL="error"
PRETTY_LOGS=false
CORS_ALLOWED_ORIGINS=""

# DATABASE — points at the test Postgres container (port 5434)

DB_HOST=localhost
DB_PORT=5434
DB_USER=nestjstemplatev2
DB_NAME=nestjstemplatev2
DB_PASSWORD=nestjstemplatev2
DB_SSL=false
DATABASE_URL="postgresql://nestjstemplatev2:nestjstemplatev2@localhost:5434/nestjstemplatev2?sslmode=disable"
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=5000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=60000

# TELEMETRY — not setting OTEL_EXPORTER_OTLP_ENDPOINT avoids the validation requiring all OTEL vars
OTEL_SERVICE_NAME=""
OTEL_RESOURCE_ATTRIBUTES=""

# AUTH

AUTH_PROVIDER="mock"

# GCS — fake-gcs in the test stack runs on port 4444

GCS_SERVICE_ACCOUNT_JSON=
STORAGE_GCS_ENDPOINT="http://localhost:4444"

# PROCESSING — fast workflow-timeout for E2E timeout coverage (default is 900000)
PROCESSING_WORKER_WORKFLOW_TIMEOUT_MS=5000
