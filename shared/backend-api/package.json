{
  "name": "@shared/backend-api",
  "version": "0.0.0",
  "private": true,
  "license": "PROPRIETARY",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/shared/validation-constants.d.ts",
      "default": "./dist/shared/validation-constants.js"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  },
  "scripts": {
    "type-check": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "// ============================ sytle ============================ //": "",
    "lint": "eslint \"./**/*.ts\"",
    "lint:fix": "eslint \"./**/*.ts\" --fix",
    "format": "prettier --write \"./**/*.ts\" --ignore-path ../../.prettierignore",
    "format-check": "prettier --check \"./**/*.ts\" --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@shared/style-config": "workspace:*",
    "@shared/typescript-config": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "tslib": "^2.8.1",
    "vitest": "^4.1.2"
  }
}
